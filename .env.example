# 本機腳本讀 .env.local（已 gitignore），不要 commit 真的值
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DB_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
# 選填：off＝不用 Google 搜尋 grounding（免費額度沒有，省一次失敗呼叫）；預設先試 grounded，額度不可用時自動退回不搜尋
GEMINI_GROUNDING=
GOOGLE_PLACES_SERVER_KEY=
# 僅供 npm run db:types 產生型別用（Supabase 個人 access token）
SUPABASE_ACCESS_TOKEN=
